---
layout: null
permalink: /members-data.json
---
{
  "members": [
    {% for member in site.data.members.members %}
    {
      "id": {{ member.id | jsonify }},
      "first_name": {{ member.first_name | jsonify }},
      "folders": [
        {% for folder in member.folders %}
        {
          "name": {{ folder.name | jsonify }},
          "id": {{ folder.id | jsonify }}
        }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ],
      "active": {{ member.active | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}